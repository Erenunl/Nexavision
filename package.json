{
  "name": "nexavision-discord-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Country, song, deadline, private voting, announcement and Stage modules for a Discord contest bot.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run"
  },
  "engines": {
    "node": "20.x"
  },
  "dependencies": {
    "@discordjs/voice": "0.18.0",
    "better-sqlite3": "^11.8.1",
    "discord.js": "^14.18.0",
    "dotenv": "^16.4.7",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "opusscript": "^0.1.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "opusscript": "$opusscript"
  }
}
